# Copy to .env (ignored by Git) and fill in the blanks. Variables already set
# in the environment win over this file; see CONFIGURATION.md.

# Required. Application under test.
BASE_URL=https://www.saucedemo.com
# Required. Password shared by the application's test users. For Sauce Demo
# it is public: the login page shows it.
TEST_USER_PASSWORD=

# Optional. chrome or firefox (default: chrome).
BROWSER=
# Optional. true or false (default: true).
HEADLESS=
# Optional. Width,height (default: 1920,1080).
WINDOW_SIZE=
# Optional. Selenium Grid URL, e.g. http://localhost:4444 from compose.yaml.
# Blank runs a local browser.
SELENIUM_REMOTE_URL=
